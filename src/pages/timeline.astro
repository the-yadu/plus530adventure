---
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { getGroupedTimelineBatches } from '../utils/timeline';
import { getAdventureUrl, getTypeLabel } from '../data/adventures';
import { Calendar, ArrowRight, Clock, ShieldCheck } from '@lucide/astro';

const monthGroups = getGroupedTimelineBatches();
---

<Layout
  title="Upcoming Expeditions Timeline | Plus530 Adventure"
  description="View all upcoming car convoy and motorcycle tour batch dates in a chronological timeline view."
>
  <div>
    {/* Page Header */}
    <section class="bg-gray-900 text-white py-16">
      <Container className="text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Expedition Timeline</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Browse upcoming departure dates chronologically and reserve your spot in the next convoy
        </p>
      </Container>
    </section>

    {/* Timeline Content */}
    <section class="py-16 bg-cream-50 min-h-screen">
      <Container className="max-w-5xl">
        {/* Type Filter Pills */}
        <div class="flex flex-wrap gap-3 mb-12 justify-center" id="timeline-filters">
          <button
            data-filter="all"
            class="timeline-filter-tab px-5 py-2.5 rounded-full text-sm font-bold transition-all duration-200 bg-orange-600 text-white shadow-md"
          >
            All Expeditions
          </button>
          <button
            data-filter="car"
            class="timeline-filter-tab px-5 py-2.5 rounded-full text-sm font-bold transition-all duration-200 bg-white border border-gray-200 text-gray-700 hover:bg-orange-50 hover:text-orange-600 shadow-sm"
          >
            Car Convoys
          </button>
          <button
            data-filter="motorcycle"
            class="timeline-filter-tab px-5 py-2.5 rounded-full text-sm font-bold transition-all duration-200 bg-white border border-gray-200 text-gray-700 hover:bg-orange-50 hover:text-orange-600 shadow-sm"
          >
            Motorcycle Tours
          </button>
        </div>

        {monthGroups.length === 0 ? (
          <div class="text-center py-16 bg-white rounded-2xl p-8 border border-gray-200 shadow-sm">
            <Calendar class="w-12 h-12 text-gray-400 mx-auto mb-4" />
            <h3 class="text-xl font-bold text-gray-900 mb-2">No Upcoming Batches Found</h3>
            <p class="text-gray-600 max-w-md mx-auto mb-6">
              Check back soon for new batch announcements or contact us for custom private group dates.
            </p>
            <a href="/contact">
              <Button>Contact Us for Custom Dates</Button>
            </a>
          </div>
        ) : (
          <div class="relative pl-6 md:pl-0">
            {/* Central Vertical Guide Line (Mobile: left aligned, Desktop: left aligned for clean layout) */}
            <div class="absolute left-6 md:left-24 top-4 bottom-4 w-0.5 bg-orange-200 -z-0"></div>

            {monthGroups.map((group) => (
              <div class="mb-16 month-group-block">
                {/* Month Group Header Badge */}
                <div class="relative z-10 flex items-center gap-3 mb-8">
                  <div class="bg-gray-900 text-white px-5 py-2 rounded-full font-bold text-sm tracking-wide shadow-lg flex items-center gap-2 border border-gray-700">
                    <Calendar class="w-4 h-4 text-orange-400" />
                    <span>{group.monthYearKey}</span>
                  </div>
                  <div class="h-0.5 flex-1 bg-gray-200 hidden md:block"></div>
                </div>

                {/* Batch Nodes in Month */}
                <div class="space-y-8">
                  {group.items.map((item) => (
                    <div
                      class="timeline-card-item relative flex flex-col md:flex-row gap-6 items-start"
                      data-type={item.adventure.type}
                    >
                      {/* Left Date Column */}
                      <div class="flex items-center gap-3 md:w-44 flex-shrink-0 z-10">
                        {/* Timeline Node Dot */}
                        <div class="w-5 h-5 rounded-full bg-orange-600 border-4 border-white shadow-md flex-shrink-0 -ml-2.5 md:ml-21.5"></div>
                        <div class="bg-orange-100 text-orange-800 px-3.5 py-1.5 rounded-xl font-extrabold text-sm shadow-sm border border-orange-200">
                          {item.formattedDay}
                        </div>
                      </div>

                      {/* Main Card Content */}
                      <div class="flex-1 w-full bg-white rounded-2xl border border-gray-200/80 p-5 md:p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
                        <div class="flex flex-col lg:flex-row gap-6">
                          {/* Image Thumbnail */}
                          <div class="w-full lg:w-56 h-44 rounded-xl overflow-hidden relative flex-shrink-0 bg-gray-100">
                            <img
                              src={item.adventure.image || item.adventure.backgroundImage}
                              alt={item.adventure.title}
                              class="w-full h-full object-cover"
                            />
                            {item.adventure.featured && (
                              <span class="absolute top-3 left-3 bg-green-600 text-white text-xs font-semibold px-2.5 py-1 rounded-full shadow-md">
                                Featured
                              </span>
                            )}
                          </div>

                          {/* Content Details */}
                          <div class="flex-1 flex flex-col justify-between">
                            <div>
                              <div class="flex flex-wrap items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider text-orange-600 bg-orange-50 px-2.5 py-1 rounded-md border border-orange-100">
                                  {getTypeLabel(item.adventure.type)}
                                </span>
                                <span class="text-xs text-gray-500 flex items-center gap-1">
                                  <Clock class="w-3.5 h-3.5" />
                                  {item.adventure.duration}
                                </span>
                              </div>

                              <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
                                {item.adventure.title}
                              </h3>
                              <p class="text-gray-600 text-sm line-clamp-2 mb-4">
                                {item.adventure.description}
                              </p>
                            </div>

                            {/* Footer Price & Buttons */}
                            <div class="pt-4 border-t border-gray-100 flex flex-wrap items-center justify-between gap-4">
                              <div>
                                <span class="text-2xl font-extrabold text-orange-600">{item.adventure.price}</span>
                                <span class="text-xs text-gray-500 block">per person (Double Sharing)</span>
                              </div>

                              <div class="flex items-center gap-3">
                                <a
                                  href={getAdventureUrl(item.adventure)}
                                  class="text-sm font-semibold text-gray-700 hover:text-orange-600 px-3 py-2 transition-colors"
                                >
                                  Details
                                </a>
                                <a
                                  href={`/contact?adventure=${item.adventure.slug}&batch=${encodeURIComponent(item.dateStr)}`}
                                  class="inline-flex items-center gap-1.5 px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white font-bold text-sm rounded-xl shadow-md transition-all"
                                >
                                  <span>Book This Batch</span>
                                  <ArrowRight class="w-4 h-4" />
                                </a>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )}
      </Container>
    </section>
  </div>
</Layout>

<script>
  const filterTabs = document.querySelectorAll('.timeline-filter-tab');
  const items = document.querySelectorAll('.timeline-card-item');

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const filter = tab.getAttribute('data-filter');

      filterTabs.forEach((t) => {
        t.className =
          'timeline-filter-tab px-5 py-2.5 rounded-full text-sm font-bold transition-all duration-200 bg-white border border-gray-200 text-gray-700 hover:bg-orange-50 hover:text-orange-600 shadow-sm';
      });
      tab.className =
        'timeline-filter-tab px-5 py-2.5 rounded-full text-sm font-bold transition-all duration-200 bg-orange-600 text-white shadow-md';

      items.forEach((item) => {
        const itemType = item.getAttribute('data-type');
        if (filter === 'all' || itemType === filter) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
