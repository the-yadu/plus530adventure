---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import { adventures, getAdventureBySlug } from '../../data/adventures';
import { Calendar, TrendingUp, BadgeInfo, Check, ArrowLeft } from '@lucide/astro';

export async function getStaticPaths() {
  return adventures.map((adventure) => ({
    params: { slug: adventure.slug },
    props: { adventure },
  }));
}

const { adventure } = Astro.props;
---

<Layout title={`${adventure.title} | Plus530 Adventure`} description={adventure.description}>
  <div>
    {/* Hero Section */}
    <section class="relative h-[60vh] flex items-center justify-center">
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-black/50 z-10"></div>
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image: url('${adventure.backgroundImage || adventure.image}')`}
      ></div>
      <Container className="relative z-20">
        <a href="/adventures" class="inline-flex items-center text-white hover:text-orange-400 mb-6 transition-colors font-medium">
          <ArrowLeft class="mr-2 h-5 w-5 inline-block" />
          Back to Adventures
        </a>
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-4">
          {adventure.title}
        </h1>
        <p class="text-xl text-gray-200 max-w-3xl">
          {adventure.description}
        </p>
      </Container>
    </section>

    {/* Quick Info Bar */}
    <section class="bg-white shadow-md sticky top-16 z-40">
      <Container>
        <div class="flex flex-wrap items-center justify-between py-4 gap-4">
          <div class="flex items-center space-x-6">
            <div class="flex items-center space-x-2">
              <Calendar class="h-5 w-5 text-orange-600" />
              <span class="font-semibold">{adventure.duration}</span>
            </div>
            <div class="flex items-center space-x-2">
              <TrendingUp class="h-5 w-5 text-orange-600" />
              <span class="font-semibold">{adventure.difficulty}</span>
            </div>
            <div class="flex items-center space-x-2">
              <BadgeInfo class="h-5 w-5 text-orange-600 flex-shrink-0" />
              <div>
                <span class="font-semibold text-orange-600 text-xl">{adventure.price}</span>
                <span class="text-xs text-gray-500 block font-medium">per person (Double Sharing)</span>
              </div>
            </div>
          </div>
          <a href="/contact">
            <Button>Book Now</Button>
          </a>
        </div>
      </Container>
    </section>

    {/* Overview Section */}
    <section class="py-16 bg-gray-50">
      <Container>
        <div class="max-w-4xl">
          {/* Pricing & Occupancy Note */}
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8 flex items-start space-x-3">
            <BadgeInfo class="h-6 w-6 text-amber-600 flex-shrink-0 mt-0.5" />
            <div class="text-sm text-amber-900 leading-relaxed">
              <span class="font-bold block mb-1">Room Occupancy & Pricing Policy:</span>
              Prices shared across all expeditions are <strong>per person on a double-sharing basis</strong> (2 persons sharing 1 room). In case you prefer <strong>single occupancy (no room sharing)</strong>, the price will be <strong>2x (doubled)</strong>.
            </div>
          </div>

          <h2 class="text-3xl font-bold text-gray-900 mb-6">Overview</h2>
          <p class="text-lg text-gray-700 leading-relaxed">
            {adventure.longDescription}
          </p>
        </div>
      </Container>
    </section>

    {/* Highlights Section */}
    <section class="py-16 bg-white">
      <Container>
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Highlights</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {adventure.highlights.map((highlight: string) => (
            <div class="flex items-start space-x-3">
              <Check class="h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">{highlight}</span>
            </div>
          ))}
        </div>
      </Container>
    </section>

    {/* What's Included Section */}
    <section class="py-16 bg-gray-50">
      <Container>
        <h2 class="text-3xl font-bold text-gray-900 mb-8">What's Included</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {adventure.included.map((item: string) => (
            <div class="flex items-start space-x-3">
              <Check class="h-6 w-6 text-orange-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">{item}</span>
            </div>
          ))}
        </div>
      </Container>
    </section>

    {/* Itinerary Section */}
    <section class="py-16 bg-white">
      <Container>
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Detailed Itinerary</h2>
        <div class="space-y-6">
          {adventure.itinerary.map((day: { day: number; title: string; description: string }) => (
            <div class="bg-gray-50 rounded-lg p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-12 h-12 bg-orange-600 text-white rounded-full flex items-center justify-center font-bold">
                  {day.day}
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-bold text-gray-900 mb-2">{day.title}</h3>
                  <p class="text-gray-700">{day.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    {/* CTA Section */}
    <section class="py-16 bg-gradient-to-r from-orange-600 to-orange-700 text-white">
      <Container>
        <div class="text-center">
          <h2 class="text-4xl font-bold mb-4">Ready for This Adventure?</h2>
          <p class="text-xl mb-8 max-w-2xl mx-auto text-gray-100">
            Get in touch with us to book your spot or customize this adventure to your preferences
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact">
              <Button size="lg" variant="secondary" className="bg-white text-orange-600 hover:bg-gray-100">
                Book This Adventure
              </Button>
            </a>
            <a href="/adventures">
              <Button size="lg" variant="outline" className="bg-white/10 backdrop-blur-sm border-white text-white hover:bg-white hover:text-orange-600">
                View More Adventures
              </Button>
            </a>
          </div>
        </div>
      </Container>
    </section>
  </div>
</Layout>
