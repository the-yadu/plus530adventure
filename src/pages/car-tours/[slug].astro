---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import { adventures } from '../../data/adventures';
import { WHATSAPP_COMMUNITY_URL } from '../../data/config';
import { Calendar, Clock, TrendingUp, BadgeInfo, Check, ArrowLeft } from '@lucide/astro';

import { getUpcomingBatchDates } from '../../utils/dates';

export async function getStaticPaths() {
  return adventures.filter(a => a.type === 'car').map((adventure) => ({
    params: { slug: adventure.slug },
    props: { adventure },
  }));
}


const { adventure } = Astro.props;
const upcomingBatchDates = getUpcomingBatchDates(adventure.nextBatchDates);

const adventureSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": adventure.title,
  "description": adventure.description,
  "image": `https://plus530adventure.com${adventure.image}`,
  "touristType": ["Overland Travelers", "Off-Road Enthusiasts", "Adventure Travelers"],
  ...(upcomingBatchDates.length > 0 ? { "startDate": upcomingBatchDates } : {}),
  "offers": {
    "@type": "Offer",
    "price": adventure.price.replace(/[^0-9]/g, ''),
    "priceCurrency": "INR",
    "availability": "https://schema.org/InStock",
    "url": Astro.url.href
  },
  "provider": {
    "@type": "TravelAgency",
    "name": "Plus530 Adventure",
    "url": "https://plus530adventure.com"
  },
  "itinerary": adventure.itinerary.map((item: { day: number; title: string; description: string }) => ({
    "@type": "City",
    "name": `Day ${item.day}: ${item.title}`,
    "description": item.description
  }))
};
---

<Layout title={`${adventure.title} | Plus530 Adventure`} description={adventure.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(adventureSchema)} />
  <div>
    {/* Hero Section */}
    <section class="relative h-[60vh] flex items-center justify-center">
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-black/50 z-10"></div>
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image: url('${adventure.backgroundImage || adventure.image}')`}
      ></div>
      <Container className="relative z-20">
        <a href="/adventures" class="inline-flex items-center text-white hover:text-orange-400 mb-6 transition-colors font-medium">
          <ArrowLeft class="mr-2 h-5 w-5 inline-block" />
          Back to Adventures
        </a>
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-4">
          {adventure.title}
        </h1>
        <p class="text-xl text-gray-200 max-w-3xl">
          {adventure.description}
        </p>
      </Container>
    </section>

    {/* Quick Info Bar */}
    <section class="bg-white shadow-md sticky top-16 z-40">
      <Container>
        <div class="flex flex-wrap items-center justify-between py-4 gap-4">
          <div class="flex flex-wrap items-center gap-6">
            <div class="flex items-center space-x-2">
              <Clock class="h-5 w-5 text-orange-600 flex-shrink-0" />
              <span class="font-semibold">{adventure.duration}</span>
            </div>
            <div class="flex items-center space-x-2">
              <TrendingUp class="h-5 w-5 text-orange-600 flex-shrink-0" />
              <span class="font-semibold">{adventure.difficulty}</span>
            </div>
            <div class="flex items-center space-x-2">
              <Calendar class="h-5 w-5 text-orange-600 flex-shrink-0" />
              <div>
                <span class="text-xs text-gray-500 block font-medium">Next Batch</span>
                <span class="font-semibold text-gray-900 text-sm">
                  {upcomingBatchDates.length > 0
                    ? upcomingBatchDates.join(' | ')
                    : 'Dates on Request'}
                </span>
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <BadgeInfo class="h-5 w-5 text-orange-600 flex-shrink-0" />
              <div>
                <span class="font-semibold text-orange-600 text-xl">{adventure.price}</span>
                <span class="text-xs text-gray-500 block font-medium">per person (Double Sharing)</span>
              </div>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <a href={`/contact?adventure=${adventure.slug}${upcomingBatchDates.length > 0 ? `&batch=${encodeURIComponent(upcomingBatchDates[0])}` : ''}`}>
              <Button>Book Now</Button>
            </a>
            <a
              href={WHATSAPP_COMMUNITY_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-2 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow transition-all duration-200"
            >
              <svg class="h-4 w-4 fill-current text-white" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.205 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-0.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Join WhatsApp</span>
            </a>
          </div>
        </div>
      </Container>
    </section>

    {/* Overview Section */}
    <section class="py-16 bg-gray-50">
      <Container>
        <div class="max-w-4xl">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Overview</h2>
          <p class="text-lg text-gray-700 leading-relaxed">
            {adventure.longDescription}
          </p>
        </div>
      </Container>
    </section>

    {/* Highlights Section */}
    <section class="py-16 bg-white">
      <Container>
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Highlights</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {adventure.highlights.map((highlight: string) => (
            <div class="flex items-start space-x-3">
              <Check class="h-6 w-6 text-green-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">{highlight}</span>
            </div>
          ))}
        </div>
      </Container>
    </section>

    {/* Photo Gallery Section */}
    {adventure.gallery && adventure.gallery.length > 0 && (
      <section class="py-16 bg-cream-50">
        <Container>
          <div class="mb-8">
            <h2 class="text-3xl font-bold text-gray-900 mb-2">Expedition Gallery</h2>
            <p class="text-gray-600">A glimpse into the stunning landscapes, cultural sites, and 4x4 trails of this journey</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {adventure.gallery.map((img: string, idx: number) => (
              <div class="group relative h-64 rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300">
                <img
                  src={img}
                  alt={`${adventure.title} photo ${idx + 1}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                  <span class="text-white text-sm font-semibold">{adventure.title} — Photo {idx + 1}</span>
                </div>
              </div>
            ))}
          </div>
        </Container>
      </section>
    )}

    {/* What's Included Section */}
    <section class="py-16 bg-gray-50">
      <Container>
        <h2 class="text-3xl font-bold text-gray-900 mb-8">What's Included</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {adventure.included.map((item: string) => (
            <div class="flex items-start space-x-3">
              <Check class="h-6 w-6 text-orange-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">{item}</span>
            </div>
          ))}
        </div>
      </Container>
    </section>

    {/* Itinerary Section */}
    <section class="py-16 bg-white">
      <Container>
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Detailed Itinerary</h2>
        <div class="space-y-6">
          {adventure.itinerary.map((day: { day: number; title: string; description: string }) => (
            <div class="bg-gray-50 rounded-lg p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-12 h-12 bg-orange-600 text-white rounded-full flex items-center justify-center font-bold">
                  {day.day}
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-bold text-gray-900 mb-2">{day.title}</h3>
                  <p class="text-gray-700">{day.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    {/* Pricing & Occupancy Policy Section */}
    <section class="py-8 bg-gray-50 border-t border-gray-200">
      <Container>
        <div class="max-w-4xl mx-auto">
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 flex items-start space-x-3">
            <BadgeInfo class="h-6 w-6 text-amber-600 flex-shrink-0 mt-0.5" />
            <div class="text-sm text-amber-900 leading-relaxed">
              <span class="font-bold block mb-1">Room Occupancy & Pricing Policy:</span>
              Prices shared across all expeditions are <strong>per person on a double-sharing basis</strong> (2 persons sharing 1 room). In case you prefer <strong>single occupancy (no room sharing)</strong>, the price will be <strong>2x (doubled)</strong>.
            </div>
          </div>
        </div>
      </Container>
    </section>

    {/* CTA Section */}
    <section class="py-16 bg-gradient-to-r from-orange-600 to-orange-700 text-white">
      <Container>
        <div class="text-center">
          <h2 class="text-4xl font-bold mb-4">Ready for This Adventure?</h2>
          <p class="text-xl mb-8 max-w-2xl mx-auto text-gray-100">
            Get in touch with us to book your spot or customize this adventure to your preferences
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={`/contact?adventure=${adventure.slug}${upcomingBatchDates.length > 0 ? `&batch=${encodeURIComponent(upcomingBatchDates[0])}` : ''}`}>
              <Button size="lg" variant="secondary" className="bg-white text-orange-600 hover:bg-gray-100">
                Book This Adventure
              </Button>
            </a>
            <a href="/adventures">
              <Button size="lg" variant="outline" className="bg-white/10 backdrop-blur-sm border-white text-white hover:bg-white hover:text-orange-600">
                View More Adventures
              </Button>
            </a>
          </div>
        </div>
      </Container>
    </section>
  </div>
</Layout>
