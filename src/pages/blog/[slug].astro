---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { Calendar, User, ArrowLeft } from '@lucide/astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} | Plus530 Blog`} description={post.data.excerpt}>
  <article class="py-12 bg-white">
    <Container className="max-w-4xl">
      <a href="/blog" class="inline-flex items-center text-orange-600 hover:text-orange-700 mb-8 font-medium">
        <ArrowLeft class="mr-2 h-4 w-4" />
        Back to Blog
      </a>

      <header class="mb-8">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">{post.data.title}</h1>
        <div class="flex items-center text-gray-600 space-x-6 text-sm">
          <div class="flex items-center space-x-2">
            <User class="h-4 w-4 text-orange-600" />
            <span>{post.data.author}</span>
          </div>
          <div class="flex items-center space-x-2">
            <Calendar class="h-4 w-4 text-orange-600" />
            <span>{post.data.date}</span>
          </div>
        </div>
      </header>

      <div class="relative h-96 rounded-2xl overflow-hidden mb-12 shadow-lg">
        <img
          src={post.data.image}
          alt={post.data.title}
          class="w-full h-full object-cover"
        />
      </div>

      <div class="prose prose-lg max-w-none text-gray-800 leading-relaxed">
        <Content />
      </div>
    </Container>
  </article>
</Layout>
